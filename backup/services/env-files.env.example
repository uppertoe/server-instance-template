# backup/services/env-files.env — Encrypted off-host copy of the secret files.
#
# Copy this file to backup/services/env-files.env and fill in the two Restic
# values. Files matching backup/services/*.env are gitignored.
#
# WHY THIS SERVICE EXISTS
# The per-app .env files (and the backup config itself) are gitignored and
# exist ONLY on the VPS. Without this service, losing the box means losing
# every credential — the databases restore, but nothing can start until every
# SMTP/S3/session/token secret has been re-minted from memory. This files-only
# service snapshots them hourly with the rest of the backups; restic encrypts
# client-side (AES-256), so the copies are protected at rest wherever they land.
#
# ⚠ RECOVERY ROOT — READ THIS
# This service's RESTIC_REPOSITORY and RESTIC_PASSWORD are the one credential
# pair that CANNOT live only on the box (they unlock everything else after a
# total loss). Store BOTH in your practice's password manager the day you
# create this file. That pair + this repository = full secret recovery;
# neither alone is useful to an attacker without the other.
#
# Restore after a rebuild (before ./deploy):
#   sudo /opt/backup/restore.sh --service env-files

# ---------------------------------------------------------------------------
# Service identity
# ---------------------------------------------------------------------------
SERVICE_NAME=env-files

# ---------------------------------------------------------------------------
# Restic repository — dedicated repository, dedicated passphrase (see above).
# ---------------------------------------------------------------------------
RESTIC_REPOSITORY=s3:s3.amazonaws.com/mybucket/backups/env-files-backup
RESTIC_PASSWORD=

# Files-only mode: DB_NAME stays empty.
DB_NAME=

# The secret files. BACKUP_PATHS is colon-separated and not glob-expanded, so
# directories are listed rather than patterns: apps/ carries each app's .env
# (the committed compose/caddy files it also contains are tiny and harmless to
# include), backup/ carries config.env + services/*.env.
BACKUP_PATHS=/opt/deploy/.env:/opt/deploy/apps:/opt/deploy/backup

# Skip gracefully on hosts where an optional path is absent.
OPTIONAL=false
