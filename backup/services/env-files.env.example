# backup/services/env-files.env — Encrypted off-host copy of the secret files.
#
# Copy this file to backup/services/env-files.env and fill in the two Restic
# values. Files matching backup/services/*.env are gitignored.
#
# WHY THIS SERVICE EXISTS
# The per-app .env files (and the backup config itself) are gitignored and
# exist ONLY on the VPS. Without this service, losing the box means losing
# every credential — the databases restore, but nothing can start until every
# SMTP/S3/session/token secret has been re-minted from memory. This files-only
# service snapshots them hourly with the rest of the backups; restic encrypts
# client-side (AES-256), so the copies are protected at rest wherever they land.
#
# ⚠ RECOVERY ROOT — READ THIS
# This service's RESTIC_REPOSITORY and RESTIC_PASSWORD are the credential pair
# that CANNOT live only on the box: they unlock a repository holding a full copy
# of every secret on the host — the per-app .env files AND the backup system's
# own config (/etc/restic: config.env + every OTHER service's restic password).
# Store BOTH values in your practice's password manager the day you create this
# file.
#
# One catch: the repository lives in S3, so pulling it after a total loss also
# needs the AWS read keys (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) that live
# in config.env — a bootstrap you can't satisfy from inside the very repo you're
# trying to open. Keep those two keys in the password manager alongside the
# pair. So: pair + AWS read keys + this repository = full secret recovery; none
# of them alone is useful to an attacker.
#
# This is the redundant, S3-side twin of the encrypted off-box recovery bundle
# (scaffold/docs/09-recovery.md) — either path independently reconstructs every
# secret. Restore after a rebuild (before ./deploy):
#   sudo /opt/backup/restore.sh --service env-files

# ---------------------------------------------------------------------------
# Service identity
# ---------------------------------------------------------------------------
SERVICE_NAME=env-files

# ---------------------------------------------------------------------------
# Restic repository — dedicated repository, dedicated passphrase (see above).
# ---------------------------------------------------------------------------
RESTIC_REPOSITORY=s3:s3.amazonaws.com/mybucket/backups/env-files-backup
RESTIC_PASSWORD=

# Files-only mode: DB_NAME stays empty.
DB_NAME=

# The secret files. BACKUP_PATHS is colon-separated and not glob-expanded, so
# directories are listed rather than patterns:
#   /opt/deploy/.env  — top-level DOMAIN etc.
#   /opt/deploy/apps  — each app's filled .env (the committed compose/caddy files
#                       it also contains are tiny and harmless to include)
#   /etc/restic       — the backup system's own config: config.env (S3 creds,
#                       retention, alert SMTP) + services/*.env (every service's
#                       restic repo password). This is what makes env-files a
#                       genuine recovery root rather than an app-secrets-only copy.
#
# NOTE: the real backup config lives at /etc/restic (root:0600, deployed there
# from your laptop by ansible/backup.yml) — NOT under /opt/deploy/backup. That
# clone path holds only the *.env.example templates; the filled configs are
# gitignored and never land there. Backing up /opt/deploy/backup would capture
# nothing but examples, which is why this lists /etc/restic instead.
BACKUP_PATHS=/opt/deploy/.env:/opt/deploy/apps:/etc/restic

# Skip gracefully on hosts where an optional path is absent.
OPTIONAL=false
