# Copy to ansible/hosts (gitignored) and set your server's IP.
# Replace "myserver" with your own SSH alias, and use that same alias in
# ~/.ssh/config, Ansible commands, and the smoke test script.
#
# Usage:
#   ansible-playbook -i ansible/hosts scaffold/ansible/bootstrap.yml
#   ansible-playbook -i ansible/hosts scaffold/ansible/site-first-run.yml
#   ansible-playbook -i ansible/hosts scaffold/ansible/site-quick.yml

[servers]
myserver ansible_host=YOUR_SERVER_IP
# To harden a host to CIS Ubuntu 24.04 Level 2 Server, set the flag as a HOST
# var on the host line (as below) — NOT under [servers:vars]. As an inventory
# *group* var it would be outranked by the scaffold's playbook group_vars default
# (false) and silently disabled. Audit with the L2 tailoring profile:
#   -e openscap_tailoring_profile=xccdf_org.ssgproject.content_profile_cis_level2_server_cloud_vps
# myserver ansible_host=YOUR_SERVER_IP baseline_cis_l2_audit_rules=true
#
# The scaffold installs the notify client + AIDE/unit/backup alerting on every
# host. The bundled ntfy server (apps/ntfy, enabled in docker-compose) is the
# local destination -- point the notify role at it so alerts are delivered.
# Mint a publish token once ntfy is up (`./deploy`, then
# `docker compose exec ntfy ntfy token add admin`) and set it here; the URL
# stays loopback (phone delivery is a separate opt-in -- see apps/ntfy/README.md):
# myserver ansible_host=YOUR_SERVER_IP baseline_cis_l2_audit_rules=true notify_ntfy_url=http://127.0.0.1:8080/alerts notify_ntfy_token=tk_REPLACE_WITH_TOKEN

[servers:vars]
ansible_user=deploy
# Bootstrap copies the matching .pub for this key onto the server.
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3
# Managed swapfile and lightweight host monitoring are enabled by default.
# Override per host or per group if needed, for example:
# host_swapfile_enabled=true
# host_swapfile_size_mb=4096
# host_monitoring_enabled=true
# host_earlyoom_enabled=true
# host_earlyoom_min_free_mem_percent=5
# host_earlyoom_min_free_swap_percent=10
# Logging retention defaults are also managed for small VPSes.
# Override per host if needed, for example:
# baseline_journald_system_max_use=300M
# baseline_journald_system_keep_free=500M
# baseline_journald_max_file_sec=1month
# baseline_auditd_max_log_file_mb=25
# baseline_auditd_num_logs=8
# baseline_auditd_max_log_file_action=ROTATE
# Backups run hourly by default; set verify to an explicit off-hour time so
# weekly prune/check work is less likely to overlap with a normal backup.
# backup_verify_schedule=Sun *-*-* 03:17:00
# Faster default site runs skip safe apt upgrades and AIDE DB initialization.
# Turn them on explicitly when needed:
# common_run_safe_upgrade=true
# baseline_initialize_aide_database=true
# Enable for Redis or similar workloads that require vm.overcommit_memory=1.
# host_vm_overcommit_memory_enabled=true
#
# --- Compliance/evidence controls (see scaffold/docs/compliance-plan-vic-health.md) ---
# Encrypted swap is ON by default (random key per boot via crypttab). Disable
# only with a documented reason:
# host_swap_encrypted=false
#
# External dead-man's switch: the monitor alarms when pings stop — the one
# alert on-box ntfy can't send. For a self-hosted Gatus on another machine,
# point at an external-endpoint (heartbeat.interval ~15m on the Gatus side,
# and make sure Gatus alerts via a channel independent of this VPS):
# notify_deadman_url=https://gatus.example/api/v1/endpoints/vps_heartbeat/external?success=true
# notify_deadman_token=REPLACE_WITH_GATUS_ENDPOINT_TOKEN
# Or a Healthchecks/Uptime Kuma push URL (plain GET, token in the URL):
# notify_deadman_url=https://hc-ping.com/REPLACE-WITH-UUID
# The heartbeat is REQUIRED: provisioning fails when unset. To knowingly run
# without one (the host's own death becomes invisible):
# notify_deadman_accept_none=true
#
# Patch-window reboots (kernel updates only apply after one) happen at 04:30
# by default; vps-boot-check pushes the outcome via ntfy. Adjust or disable:
# common_automatic_reboot_time=04:30
# common_automatic_reboot_enabled=false
#
# Off-host tamper-evident log export (ISM-1988: 12-month retention). Create the
# Object-Locked bucket + write-only IAM user with scripts/aws-logs-setup.py,
# then paste the values it prints:
# log_export_s3_uri=s3://myorg-vps-logs/logs
# log_export_aws_access_key_id=AKIA...
# log_export_aws_secret_access_key=...
# log_export_aws_region=ap-southeast-2
#
# Daily CVE scan and patch-SLA check schedules (UTC), if the defaults collide
# with anything on your host:
# vuln_scan_schedule=*-*-* 05:41:00
# common_patch_check_schedule=*-*-* 06:15:00
# Restore drill (monthly by default; proves backups restore, records RPO/RTO):
# backup_restore_drill_schedule=*-*-03 04:23:00
#
# --- Restricted access mode (scaffold/docs/05-access-model.md) ---
# Removes deploy's root-equivalence: wrapper-only sudo, no docker group. The
# admin break-glass account is created in BOTH modes; verify it works FIRST
# (ssh admin@host 'sudo -n true'), then set these as HOST vars and switch
# ansible_user to admin — deploy can no longer become root:
# myserver ansible_host=YOUR_SERVER_IP deploy_restricted_mode=true
# ansible_user=admin
# Optional: dedicated admin key + allowlisted app-manage verbs:
# deploy_admin_public_key="ssh-ed25519 AAAA... admin@laptop"
# deploy_allowed_app_manage_commands='{"migrate": "python manage.py migrate --noinput"}'

# --- Hands-off updates ----------------------------------------------------
# Daily CI-gated auto-apply of upstream repo changes (compose/Caddy layer):
# Renovate automerges digest/submodule bumps on green CI; this timer applies
# them on the box with ntfy announcements. Opt-in.
# deploy_auto_update=true
# The weekly scaffold-drift alert (enabled by default) tells you when
# Ansible-layer changes are waiting in UPGRADING.md.
