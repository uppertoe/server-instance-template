# cms-auth — OIDC-gated commit broker for Decap CMS.
# Copy to apps/cms-auth/.env and fill in. `./deploy` enforces mode 600.
# BASE_URL, OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_EDITOR_GROUP are set from ${DOMAIN}
# in docker-compose.yml (do not set them here).

# --- CMS sites this broker serves ---
# Comma-separated admin-page origins allowed to receive the session token
# (postMessage) AND call the /api proxy (CORS). One per Hugo site, e.g.:
#   https://handbook.<DOMAIN>
ALLOWED_ORIGINS=

# Comma-separated owner/name repos the proxy may touch. The GitHub App
# installation token is scoped to exactly these. e.g.:
#   anaes-data-lab/rch-handbooks-hugo
ALLOWED_REPOS=

# --- OIDC (Authelia) confidential client secret ---
# The PLAINTEXT "Random Password" from `authelia crypto hash generate pbkdf2`;
# the matching Digest goes in apps/authelia/secrets/cms-auth.hash. See
# apps/authelia/README.md "Adding an OIDC client".
OIDC_CLIENT_SECRET=

# --- Shared GitHub App (the "bot") ---
# From the App's settings page (Contents: Read & write, installed on the repos
# above). App ID + Installation ID are identifiers, not secrets.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# The App private key, base64 of the downloaded PEM as a SINGLE line (rides
# safely in this .env regardless of container uid — no file mount). Generate:
#   base64 -w0 your-app.private-key.pem      # (macOS: base64 -i your-app.private-key.pem )
GITHUB_APP_PRIVATE_KEY_B64=

# Committer identity stamped on every commit (author is the signed-in editor).
# Use the App bot's noreply address so GitHub attributes the committer cleanly:
#   <app-id>+<app-slug>[bot]@users.noreply.github.com
COMMITTER_NAME=RCH Handbook Bot
COMMITTER_EMAIL=

# HMAC key for the state cookie + session tokens. Set it so sessions survive a
# restart (and to run more than one replica). Generate: openssl rand -hex 32
SESSION_SECRET=

# Optional: override the session-token lifetime (default 12h).
#SESSION_TTL=12h
