# apps/cms-auth/cms-auth.caddy
# Host for the Decap CMS commit broker. Only /auth sits behind the estate
# gateway: the CMS opens it in a popup, the gateway signs the editor in if
# needed, and the broker reads Remote-Email / Remote-Groups -- trusted only
# alongside the X-Gateway-Secret injected here -- and hands the CMS a signed
# session token. The /api commit proxy stays public because the CMS calls it
# cross-origin without the gateway cookie; it is authenticated by that session
# token, and the shared GitHub App key stays server-side. One broker backs
# every CMS site; each site's Decap config points base_url + api_root here.
# (Keep comments free of curly braces -- the render step counts braces.)
cms-auth.{$DOMAIN} {
	# scaffold-lint: public -- /api is open; the broker checks its own session token there
	# The editor door. The gate is the guard snippets' own auth_gate, written
	# out only because the broker needs the extra header on its reverse_proxy.
	# header_up REPLACES the header, so a client-sent secret never survives.
	route /auth {
		import strip_client_identity
		import auth_gate "groups=cms-editors"
		reverse_proxy cms-auth:8080 {
			import strip_auth_cookie
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Gateway-Secret {$CMS_AUTH_GATEWAY_SECRET:}
		}
	}

	reverse_proxy cms-auth:8080 {
		# Overwrite X-Forwarded-For with the true peer so the broker's per-IP
		# rate limiter can't be fooled by a client-supplied header.
		header_up X-Forwarded-For {http.request.remote.host}
		# The broker has its own signed session; the gateway cookie and any
		# client-sent identity headers stay with Caddy.
		import strip_public
		header_up -X-Gateway-Secret
	}
}
