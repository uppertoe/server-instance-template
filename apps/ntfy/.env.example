# ntfy self-hosted push server. Copy to apps/ntfy/.env on the server and fill in.
# Never commit the real .env — the deploy helper sets it to mode 600.

# NOTE: NTFY_BASE_URL is NOT set here — docker-compose.yml derives it from DOMAIN
# (https://ntfy.${DOMAIN}) and the compose `environment:` overrides any value in
# this file, so setting it here only causes confusion. Set DOMAIN in the repo .env.

# Optional: enable a default broadcast/iOS poll behaviour, SMTP-in, etc.
# See https://docs.ntfy.sh/config/ for the full env var list (NTFY_*).

# --- Auth bootstrap (used by deploy.sh) ---
# Admin password for the ntfy 'admin' user (created on first deploy).
NTFY_ADMIN_PASSWORD=
# The topic the host publishes alerts to (keep it unguessable).
NTFY_ALERT_TOPIC=alerts
