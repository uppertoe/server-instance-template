# Authelia secrets. Copy to apps/authelia/.env in your server repo and fill in.
# Never commit the real .env -- the deploy helper sets it to mode 600 on the
# server. Each value below is read by Authelia via its AUTHELIA_* env mapping.
#
# IMPORTANT: values here must be interpolation-safe (no '$'), because Docker
# Compose interpolates env_file values. The `openssl rand -hex` recipes below
# satisfy that. Secrets that contain '$' (e.g. pbkdf2 client-secret hashes) are
# NOT put here -- they go in mounted files under secrets/ (see secrets/*.example).

# Session signing secret. Generate with: openssl rand -hex 64
AUTHELIA_SESSION_SECRET=

# At-rest encryption key for the SQLite storage. openssl rand -hex 64
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# JWT secret used by identity-validation flows. openssl rand -hex 64
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=

# HMAC secret for the OIDC provider. openssl rand -hex 64
AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET=

# NOTE: OIDC client-secret HASHes are NOT set here -- they contain '$'. Each
# lives in secrets/<client>.hash (see secrets/cms-auth.hash.example).

# --- Email (AWS SES SMTP) ---
# Authelia requires a notifier; self-service reset is disabled (Defender Safe Links
# breaks one-time links for @rch.org.au), so this currently sends nothing -- it's
# kept ready for TOTP/2FA or notifications. Mint SES SMTP creds with
# scripts/aws-ses-setup.py (the same SES domain identity as apps/auth can be
# reused -- the SMTP user is scoped to send as *@<domain>). SES SMTP passwords
# are base64 (no '$'), so they are safe in this env_file.
# STARTTLS submission endpoint for your region:
AUTHELIA_NOTIFIER_SMTP_ADDRESS=submission://email-smtp.ap-southeast-2.amazonaws.com:587
AUTHELIA_NOTIFIER_SMTP_USERNAME=
AUTHELIA_NOTIFIER_SMTP_PASSWORD=
# From address -- must be at the SES-verified domain.
AUTHELIA_NOTIFIER_SMTP_SENDER=Authelia <auth@example.com>
