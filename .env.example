DOMAIN=myserver.example.com

# Proof-of-Caddy secret for cms-auth's gateway sign-in (apps/cms-auth). Caddy
# injects it as X-Gateway-Secret on /auth and the broker refuses a request
# without it. 32 or more characters: `openssl rand -hex 32`
# (apps/cms-auth/setup.sh writes it). Needed only while apps/cms-auth is enabled.
#CMS_AUTH_GATEWAY_SECRET=
