{
  // Renovate config. JSON5 (comments allowed) — see the FIRST-PARTY list below,
  // which is the one part you edit as you add your own apps.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  // Private first-party images need a read:packages token for digest lookups;
  // it lives in the self-hosted runner's global config, never in this file.
  // A manually closed digest PR is recreated on the next run, so a one-off
  // close never permanently stops auto-deploys (top level: not honoured
  // inside packageRules).
  "recreateWhen": "always",
  // The scaffold-managed workflow copies change only through a scaffold bump
  // plus check-server-files.sh --fix; a digest bump inside one fails CI as drift.
  "ignorePaths": [
    ".github/workflows/ci.yml",
    ".github/workflows/container-security.yml",
    ".github/workflows/secret-scan.yml",
    ".github/workflows/deploy-ping.yml",
    ".github/workflows/digest-freshness.yml",
    ".github/workflows/maintenance-day.yml",
    ".github/workflows/codeql.yml",
    ".github/workflows/scorecard.yml",
    ".github/workflows/update-pipeline-freshness.yml",
  ],
  // A timestamp-less release (every Docker digest) counts as stable, so a
  // minimumReleaseAge rule can never turn into "never".
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    // Digest-pin every Docker image. Migrated from the top-level `docker`
    // config to this packageRule form (matchCategories) per Renovate's config
    // migration — same effect, current schema.
    {
      "matchCategories": ["docker"],
      "pinDigests": true,
    },

    // ── THIRD-PARTY images ──────────────────────────────────────────────
    // Pin + group digest bumps and automerge them once repo CI is green.
    // NO minimumReleaseAge here: Renovate cannot date a Docker digest ("digest
    // update of <image> has no releaseTimestamp to age against"), and with the
    // default timestamp-required behaviour an undated update stays pending
    // forever — the old 3-day "cooldown" silently froze third-party digest
    // bumps from 2026-07-21 to 2026-09-05. A digest bump is a rebuild of the
    // same tag, so the settle window buys little; compose-smoke and the
    // container-security scan remain the gate. Version bumps of these images
    // are human-gated (no automerge rule covers them) — which only holds for
    // images pinned to a VERSION tag. A `latest` tag turns every upstream
    // release, majors included, into a "digest bump" that automerges, so the
    // third-party images are pinned to versions (ntfy v2.x, postgres, redis);
    // Renovate then proposes version bumps as ordinary PRs.
    {
      "description": "Regex-managed digest pins ride the same automerge as compose pins",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "groupName": "docker image digests",
      "automerge": true,
    },
    {
      "description": "Group Docker image digest bumps so base-image CVE fixes flow through in one PR",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "groupName": "docker image digests",
      "automerge": true,
    },

    // ── FIRST-PARTY apps ────────────────────────────────────────────────
    // Our own images are already gated by their own repo CI before they publish.
    // A match here wins over the rules above (later rules override earlier ones).
    //
    //   >>> EDIT THIS LIST when you deploy a new app of your own <<<
    //   Each entry is a Renovate package-name glob:
    //     "ghcr.io/<you>/**"  — a whole registry namespace (covers everything under it)
    //     "**/<app-name>"     — one named app, wherever it's hosted
    //     "<exact/name>"      — a single exact image name
    {
      "description": "First-party app images update in their own group",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/uppertoe/**", // the scaffold's own images: vps-scaffold-auth, hugo-orchestrate, kanban-gateway-signin
        // "ghcr.io/<your-org>/**", // add your own namespace or app names here
      ],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      // Own group, NOT the shared "docker image digests" one: a grouped PR
      // only automerges when every member's status is green, so a first-party
      // CVE fix would otherwise wait on whatever third-party member is red.
      "groupName": "first-party image digests",
      "automerge": true,
      // Main moves most days, so a PR rebased on every run never reaches the
      // merge step (open a week without merging, 2026-10-26 to 11-02). Rebase
      // only when it conflicts; a behind-but-clean PR merges.
      "rebaseWhen": "conflicted",
    },

    {
      "description": "Scaffold submodule bumps: automerge once repo CI proves the merged stack boots",
      "matchManagers": ["git-submodules"],
      "automerge": true,
      // A pointer bump moves only the submodule. Three workflow callers embed
      // the scaffold commit and the shims must match the canonical copies, so
      // the drift check (scripts/check-server-files.sh) would fail the bump.
      // Run its fix mode in the branch so the PR carries the rewritten files;
      // the command is allowlisted in the fleet runner's config.js.
      "postUpgradeTasks": {
        "commands": ["bash scripts/check-server-files.sh --fix"],
        "fileFilters": ["**/*"],
        "executionMode": "branch",
      },
    },
    {
      "description": "Automerge action pin/digest updates immediately",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true,
    },
    {
      // GitHub Actions VERSION bumps (incl. majors) automerge too — a CI-action
      // change is low-risk and trivially revertible (it never touches the
      // running stack), so it doesn't warrant a maintenance-day gate. A 3-day
      // settle lets a bad release get yanked before we adopt it. NOTE: this is
      // deliberately github-actions ONLY — docker image / DB majors (e.g.
      // postgres 16->18) stay HUMAN-gated (no automerge rule covers them), they
      // can carry breaking data migrations that need a person.
      "description": "Automerge github-actions version bumps incl. majors (3-day settle)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
    },
  ],
  "git-submodules": {
    "enabled": true,
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned scanner images in workflow docker-run lines",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9._/-]*?):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      "datasourceTemplate": "docker",
    },
  ],
}
